{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Key": "",
    "Issuer": "EventosAPI",
    "Audience": "EventosAPI",
    "ExpiresInHours": 24
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "System": "Information"
      }
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5000"
    ]
  },
  "Database": {
    "AutoMigrate": true,
    "AutoSeed": true
  },
  "DetailedErrors": true,
  "AllowedHosts": "*"
}
